{
  "name": "ai-financial-copilot",
  "version": "1.0.0",
  "description": "FinSight AI - Unified Full-Stack AI-Powered Personal Finance Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "dev": "node scripts/start-all.mjs",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-integration && python -m uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload",
    "test": "npm test --prefix backend && cd ai-integration && python -m pytest tests/",
    "build": "npm run build --prefix frontend"
  },
  "keywords": [
    "finance",
    "ai",
    "copilot",
    "fastapi",
    "react",
    "nodejs",
    "paypal"
  ],
  "license": "MIT"
}
