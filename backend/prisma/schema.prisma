generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  CSV
  PAYPAL_REPORTING
  PAYPAL_CHECKOUT
  DEMO
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum CategoryDirection {
  INCOME
  EXPENSE
  BOTH
}

enum CategorizationMethod {
  RULE
  AI
  USER
  NONE
}

enum PayPalEnvironment {
  SANDBOX
  LIVE
}

enum PayPalConnectionStatus {
  NOT_CONFIGURED
  ACTIVE
  ERROR
  DISCONNECTED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  UNKNOWN
}

enum RecurringConfidence {
  LOW
  MEDIUM
  HIGH
}

enum RecurringStatus {
  DETECTED
  CONFIRMED
  DISMISSED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum ConversationRole {
  USER
  ASSISTANT
  TOOL
}

enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
}

enum PaymentOrderStatus {
  CREATED
  APPROVED
  COMPLETED
  FAILED
  VOIDED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  fullName          String
  email             String             @unique
  passwordHash      String
  preferredCurrency String             @default("INR") @db.VarChar(3)
  timezone          String             @default("Asia/Kolkata")
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  paypalConnections PayPalConnection[]
  recurringPayments RecurringPayment[]
  reminders         Reminder[]
  conversations     AIConversation[]
  paymentOrders     PaymentOrder[]
  accounts          Account[]
  merchants         Merchant[]
  purchases         Purchase[]
  refunds           Refund[]
  savingsGoals      SavingsGoal[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  importBatches     ImportBatch[]
  financialReports  FinancialReport[]
  integrations      ConnectedIntegration[]
}

model Category {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @db.Uuid
  name         String
  direction    CategoryDirection @default(BOTH)
  isSystem     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([direction, isSystem])
}

model Transaction {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  categoryId           String?               @db.Uuid
  source               TransactionSource
  externalId           String?
  dedupeKey            String?
  merchant             String?
  description          String?
  amount               Decimal               @db.Decimal(18, 2)
  currency             String                @db.VarChar(3)
  direction            TransactionDirection
  status               TransactionStatus     @default(COMPLETED)
  transactionDate      DateTime              @db.Timestamptz(6)
  categorizationMethod CategorizationMethod? @default(NONE)
  categoryConfidence   Decimal?              @db.Decimal(5, 4)
  rawProviderData      Json?
  deletedAt            DateTime?             @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentOrder         PaymentOrder?
  paymentMethod        String?               @default("PayPal")
  accountId            String?               @db.Uuid
  account              Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, direction, status, transactionDate])
  @@index([userId, dedupeKey])
}

model Budget {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  categoryId  String?   @db.Uuid
  scopeKey    String
  amount      Decimal   @db.Decimal(18, 2)
  currency    String    @db.VarChar(3)
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  note        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, scopeKey, periodStart, currency])
  @@index([userId, periodStart, periodEnd])
}

model PayPalConnection {
  id                       String                 @id @default(uuid()) @db.Uuid
  userId                   String                 @db.Uuid
  environment              PayPalEnvironment
  merchantAccountReference String?
  webhookId                String?
  status                   PayPalConnectionStatus @default(NOT_CONFIGURED)
  lastSyncedAt             DateTime?              @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, environment])
}

model RecurringPayment {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  merchant       String
  merchantKey    String
  expectedAmount Decimal             @db.Decimal(18, 2)
  currency       String              @db.VarChar(3)
  frequency      RecurringFrequency  @default(UNKNOWN)
  nextDueAt      DateTime?           @db.Timestamptz(6)
  confidence     RecurringConfidence @default(LOW)
  status         RecurringStatus     @default(DETECTED)
  lastObservedAt DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders      Reminder[]

  @@index([userId, status, nextDueAt])
  @@index([userId, merchantKey])
}

model Reminder {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  recurringPaymentId String?           @db.Uuid
  title              String
  amount             Decimal?          @db.Decimal(18, 2)
  currency           String?           @db.VarChar(3)
  dueAt              DateTime          @db.Timestamptz(6)
  status             ReminderStatus    @default(PENDING)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringPayment   RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
}

model AIConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  title     String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           ConversationRole
  content        String           @db.Text
  toolName       String?
  toolCallId     String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  conversation   AIConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PayPalWebhookEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  providerEventId  String                  @unique
  eventType        String
  resourceId       String?
  payload          Json?
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  receivedAt       DateTime                @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?               @db.Timestamptz(6)

  @@index([eventType, receivedAt])
  @@index([resourceId])
}

model PaymentOrder {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  paypalOrderId String             @unique
  amount        Decimal            @db.Decimal(18, 2)
  currency      String             @db.VarChar(3)
  status        PaymentOrderStatus @default(CREATED)
  transactionId String?            @unique @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}



enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  PAYPAL
  INVESTMENT
  CASH
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum NotificationType {
  BILL_DUE
  BUDGET_EXCEEDED
  BUDGET_WARNING
  PAYPAL_PAYMENT
  ANOMALY_DETECTED
  SYSTEM
}

enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  name          String
  type          AccountType   @default(CHECKING)
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  currency      String        @default("INR") @db.VarChar(3)
  accountNumber String?
  institution   String?
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId, type])
}

model Merchant {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  name             String
  normalizedName   String
  category         String?
  logoUrl          String?
  totalSpent       Decimal       @default(0) @db.Decimal(18, 2)
  transactionCount Int           @default(0)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId, totalSpent])
}

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  orderNumber       String
  merchant          String
  totalAmount       Decimal        @db.Decimal(18, 2)
  currency          String         @default("INR") @db.VarChar(3)
  status            PurchaseStatus @default(COMPLETED)
  purchaseDate      DateTime       @default(now()) @db.Timestamptz(6)
  deliveryDate      DateTime?      @db.Timestamptz(6)
  trackingNumber    String?
  paymentMethod     String?
  externalReference String?
  transactionId     String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             PurchaseItem[]

  @@index([userId, purchaseDate])
  @@index([userId, merchant])
}

model PurchaseItem {
  id          String    @id @default(uuid()) @db.Uuid
  purchaseId  String    @db.Uuid
  name        String
  category    String?
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(18, 2)
  totalPrice  Decimal   @db.Decimal(18, 2)
  imageUrl    String?
  productUrl  String?
  channel3Id  String?
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Refund {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  transactionId String?           @db.Uuid
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("INR") @db.VarChar(3)
  reason        String?
  refundDate    DateTime          @default(now()) @db.Timestamptz(6)
  status        TransactionStatus @default(COMPLETED)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refundDate])
}

model SavingsGoal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  title         String
  targetAmount  Decimal    @db.Decimal(18, 2)
  currentAmount Decimal    @default(0) @db.Decimal(18, 2)
  currency      String     @default("INR") @db.VarChar(3)
  targetDate    DateTime   @db.Date
  category      String?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, targetDate])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, createdAt])
}

model ImportBatch {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  filename       String
  source         String   @default("CSV")
  totalRecords   Int      @default(0)
  importedCount  Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FinancialReport {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  title        String
  period       ReportPeriod
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  totalIncome  Decimal      @db.Decimal(18, 2)
  totalExpense Decimal      @db.Decimal(18, 2)
  netSavings   Decimal      @db.Decimal(18, 2)
  metrics      Json?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period, startDate])
}

model ConnectedIntegration {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  provider    String
  name        String
  status      String    @default("DISCONNECTED")
  config      Json?
  lastSyncAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
