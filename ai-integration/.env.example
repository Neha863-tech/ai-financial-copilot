# FinSight AI - Python FastAPI Microservice Environment Configuration

# Groq Cloud API
GROQ_API_KEY=replace_with_real_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=25

# Node.js Backend Internal Gateway
NODE_BACKEND_URL=http://localhost:5000
AI_SERVICE_API_KEY=replace_with_a_shared_random_service_key

# Microservice Settings
AI_SERVICE_PORT=8001
AI_SERVICE_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
UPLOAD_MAX_SIZE_MB=15
